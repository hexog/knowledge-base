<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kb</ToolCommandName>
    <PackageId>KnowledgeBase.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>Local portable personal knowledge base CLI</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
    <ProjectReference Include="..\KnowledgeBase.Configuration\KnowledgeBase.Configuration.csproj" />
    <ProjectReference Include="..\KnowledgeBase.Core\KnowledgeBase.Core.csproj" />
  </ItemGroup>

</Project>
